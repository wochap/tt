{
  "name": "tt-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@8.14.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter web build",
    "e2e": "pnpm --filter web e2e",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
